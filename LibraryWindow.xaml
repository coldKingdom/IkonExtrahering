<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="LibraryWindow"
        Title="Ikonbibliotek"
        Width="1040" Height="740"
        MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6F8"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F0FF"/>
        <SolidColorBrush x:Key="StrokeBrush" Color="#E3E7ED"/>
        <SolidColorBrush x:Key="TextBrush" Color="#172033"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#667085"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="20" ShadowDepth="3"
                          Direction="270" Opacity="0.10" Color="#233044"/>

        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile"
                      Viewport="0,0,20,20" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H20 V20 H0 Z"/>
                    <GeometryDrawing Brush="#E8EBEF"
                                     Geometry="M0,0 H10 V10 H0 Z M10,10 H20 V20 H10 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="ModernButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F2F4F7"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#C7CED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E8EBF0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}"
               BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="{x:Type Button}"
               BasedOn="{StaticResource ModernButton}">
            <Setter Property="Foreground" Value="#C62828"/>
            <Setter Property="BorderBrush" Value="#F0C7C7"/>
            <Setter Property="Background" Value="#FFF8F8"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="TextBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TextBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterRadio" TargetType="{x:Type RadioButton}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="FilterBorder" Background="#F5F7FA"
                                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="FilterBorder" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="FilterBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Width" Value="126"/>
            <Setter Property="Height" Value="138"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F2F5F9"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#E1E6ED"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E8EBF0" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Ikonbibliotek" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10"
                                Padding="8,3" Margin="9,1,0,0">
                            <TextBlock x:Name="LibraryCountText" Text="0"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold" FontSize="11"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="LibraryPathText" Text="Lokalt på den här datorn"
                               Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ImportLibraryButton" Style="{StaticResource ModernButton}"
                            Content="Importera…" Margin="0,0,8,0"/>
                    <Button x:Name="ExportLibraryButton" Style="{StaticResource ModernButton}"
                            Content="Exportera bibliotek…" Margin="0,0,8,0" IsEnabled="False"/>
                    <Button x:Name="CloseLibraryButton" Style="{StaticResource ModernButton}"
                            Content="Stäng"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*" MinWidth="430"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="0.85*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <Border Background="White" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="15" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="14,13,14,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="LibrarySearchBox" Style="{StaticResource ModernTextBox}"
                                     Padding="34,0,30,0" ToolTip="Sök i namn, källfil och taggar"/>
                            <TextBlock Text="⌕" FontSize="20" Foreground="{StaticResource MutedTextBrush}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,2"
                                       IsHitTestVisible="False"/>
                            <TextBlock x:Name="SearchPlaceholder" Text="Sök i biblioteket…"
                                       Foreground="#98A2B3" VerticalAlignment="Center" Margin="34,0,0,0"
                                       IsHitTestVisible="False"/>
                            <Button x:Name="ClearSearchButton" Content="×" FontSize="17"
                                    HorizontalAlignment="Right" Width="30" Background="Transparent"
                                    BorderThickness="0" Foreground="{StaticResource MutedTextBrush}"
                                    Visibility="Collapsed" Cursor="Hand"/>
                        </Grid>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,2,0,2">
                            <RadioButton x:Name="AllFilter" Content="Alla" GroupName="LibraryFilter"
                                         IsChecked="True" Style="{StaticResource FilterRadio}"/>
                            <RadioButton x:Name="FavoritesFilter" Content="★ Favoriter" GroupName="LibraryFilter"
                                         Style="{StaticResource FilterRadio}" Margin="0"/>
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="LibraryList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             Padding="10" SelectionMode="Single"
                             ItemContainerStyle="{StaticResource LibraryItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Image Source="{Binding Image}" Width="76" Height="76"
                                           Stretch="Uniform" HorizontalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Grid.Row="1" Text="{Binding Name}" Margin="0,7,0,1"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="104"
                                               Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding FavoriteGlyph}" Foreground="#F5A623"
                                               FontSize="17" HorizontalAlignment="Right"
                                               VerticalAlignment="Top" Margin="0,-5,-2,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid x:Name="LibraryEmptyState" Grid.Row="1" Background="White" IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="72" Height="72" CornerRadius="20"
                                    Background="{StaticResource AccentSoftBrush}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="◇" FontSize="34" Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Biblioteket är tomt" Margin="0,17,0,0"
                                       FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Spara en ikon från huvudfönstret eller importera ett bibliotek"
                                       Margin="0,6,0,0" MaxWidth="320" TextAlignment="Center"
                                       TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="LibraryNoResultsState" Grid.Row="1" Background="White"
                          IsHitTestVisible="False" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⌕" FontSize="42" Foreground="#A6B0BE"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Inga matchande ikoner" Margin="0,10,0,0"
                                       FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Ändra sökningen eller välj Alla"
                                       Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="15" Effect="{StaticResource CardShadow}">
                <Grid Margin="19">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,13">
                        <TextBlock Text="Sparad ikon" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="FavoriteButton" Content="☆" FontSize="24"
                                HorizontalAlignment="Right" Width="38" Height="34"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#F5A623" Cursor="Hand" IsEnabled="False"
                                ToolTip="Markera som favorit"/>
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource CheckerBrush}"
                            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                            CornerRadius="12" MinHeight="220" Margin="0,0,0,14">
                        <Image x:Name="LibraryPreview" Margin="18" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,0,0,16">
                        <TextBlock x:Name="LibraryNameText" Text="Ingen ikon vald"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="LibraryMetaText" Text="Välj en ikon i biblioteket"
                                   Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"/>
                        <TextBlock x:Name="LibrarySourceText" Text=""
                                   Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,0,0,14">
                        <TextBlock Text="Taggar" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" Margin="0,0,0,6"/>
                        <ItemsControl x:Name="TagItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8"
                                            Padding="8,4,4,4" Margin="0,0,5,5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource AccentBrush}"
                                                       VerticalAlignment="Center"/>
                                            <Button Content="×" Tag="{Binding}" Margin="5,0,0,0"
                                                    Width="19" Height="19" Background="Transparent"
                                                    BorderThickness="0" Foreground="{StaticResource AccentBrush}"
                                                    Cursor="Hand" ToolTip="Ta bort tagg"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,2,0,0">
                            <TextBox x:Name="TagInput" Style="{StaticResource ModernTextBox}"
                                     Padding="11,0,76,0" IsEnabled="False" MaxLength="30"
                                     ToolTip="Skriv en tagg och tryck Enter"/>
                            <TextBlock x:Name="TagPlaceholder" Text="Ny tagg…"
                                       Foreground="#98A2B3" VerticalAlignment="Center" Margin="12,0,0,0"
                                       IsHitTestVisible="False"/>
                            <Button x:Name="AddTagButton" Content="Lägg till" HorizontalAlignment="Right"
                                    Width="72" Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource AccentBrush}" Cursor="Hand" IsEnabled="False"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="9"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ExportLibraryIconButton" Style="{StaticResource PrimaryButton}"
                                    Content="Exportera PNG…" IsEnabled="False"/>
                            <Button x:Name="ExportLibraryIcoButton" Grid.Column="2"
                                    Style="{StaticResource ModernButton}" Content="Exportera ICO…"
                                    IsEnabled="False"/>
                        </Grid>
                        <Button x:Name="DeleteLibraryIconButton" Style="{StaticResource DangerButton}"
                                Content="Ta bort från biblioteket" Margin="0,8,0,0" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#E8EBF0" BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="7" Height="7" Fill="#22C55E" Margin="0,0,9,0"/>
                <TextBlock x:Name="LibraryStatusText" Grid.Column="1" Text="Redo"
                           VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"/>
                <TextBlock x:Name="LibraryResultsText" Grid.Column="1" Text="0 av 0"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</Window>
