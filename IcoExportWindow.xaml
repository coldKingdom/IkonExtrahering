<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="IcoExportWindow"
        Title="ICO-storlekar"
        Width="520" Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6F8"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F0FF"/>
        <SolidColorBrush x:Key="StrokeBrush" Color="#E3E7ED"/>
        <SolidColorBrush x:Key="TextBrush" Color="#172033"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#667085"/>

        <Style x:Key="ModernButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="17,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F1F4F8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="SizeCheck" TargetType="{x:Type CheckBox}">
            <Setter Property="Width" Value="132"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border x:Name="CheckBorder" Background="White"
                                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1.5"
                                CornerRadius="10" Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center"/>
                                <Border x:Name="CheckMark" Grid.Column="1" Width="20" Height="20"
                                        Background="#F3F5F8" BorderBrush="#C9D0DA"
                                        BorderThickness="1" CornerRadius="6">
                                    <TextBlock x:Name="CheckGlyph" Text="✓" Foreground="White"
                                               FontWeight="Bold" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#9DA7B5"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="CheckMark" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="CheckMark" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="24,22,24,12">
            <TextBlock Text="Välj storlekar för ICO-filen" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Windows väljer automatiskt den bild som passar bäst i varje sammanhang."
                       Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="24,0" Background="White" BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1" CornerRadius="14" Padding="12">
            <StackPanel>
                <WrapPanel HorizontalAlignment="Center">
                    <CheckBox x:Name="Size16" Style="{StaticResource SizeCheck}" Content="16 × 16" Tag="16" IsChecked="True"/>
                    <CheckBox x:Name="Size24" Style="{StaticResource SizeCheck}" Content="24 × 24" Tag="24" IsChecked="True"/>
                    <CheckBox x:Name="Size32" Style="{StaticResource SizeCheck}" Content="32 × 32" Tag="32" IsChecked="True"/>
                    <CheckBox x:Name="Size48" Style="{StaticResource SizeCheck}" Content="48 × 48" Tag="48" IsChecked="True"/>
                    <CheckBox x:Name="Size64" Style="{StaticResource SizeCheck}" Content="64 × 64" Tag="64" IsChecked="True"/>
                    <CheckBox x:Name="Size128" Style="{StaticResource SizeCheck}" Content="128 × 128" Tag="128" IsChecked="True"/>
                    <CheckBox x:Name="Size256" Style="{StaticResource SizeCheck}" Content="256 × 256" Tag="256" IsChecked="True"/>
                </WrapPanel>
                <Grid Margin="7,8,7,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SelectAllButton" Content="Markera alla" Background="Transparent"
                                BorderThickness="0" Foreground="{StaticResource AccentBrush}" Cursor="Hand"/>
                        <TextBlock Text="•" Margin="8,0" Foreground="{StaticResource MutedTextBrush}"/>
                        <Button x:Name="ClearButton" Content="Avmarkera alla" Background="Transparent"
                                BorderThickness="0" Foreground="{StaticResource AccentBrush}" Cursor="Hand"/>
                    </StackPanel>
                    <TextBlock x:Name="ValidationText" Text="Välj minst en storlek."
                               HorizontalAlignment="Right" Foreground="#C62828" Visibility="Collapsed"/>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="24,18,24,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Grid.Column="1" Style="{StaticResource ModernButton}"
                    Content="Avbryt" MinWidth="100"/>
            <Button x:Name="ContinueButton" Grid.Column="3" Style="{StaticResource PrimaryButton}"
                    Content="Fortsätt…" MinWidth="120"/>
        </Grid>
    </Grid>
</Window>
